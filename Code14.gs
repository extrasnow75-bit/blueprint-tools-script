// ============================================================
// Blueprint Tools — Code14.gs
// Blueprint Tools Version Check
// Compares the script files in THIS document with the released versions on the
// GitHub master branch, and says which files to paste again.
// ------------------------------------------------------------
// Last updated on 2026-11-03 at 12:15 MST
// ------------------------------------------------------------
//
// Spec: docs/dev-handoff/HANDOFF.md section 3.5. UI: Sidebar14.html, a pop-up
// dialog (light box), not a sidebar. Read-only: it changes nothing in the
// document. The only writes are the optional "save the results" outputs.
//
// HOW IT WORKS.
//  - master carries version-manifest.json: every script file and its "Last
//    updated on" date and time (generated by scripts/version_manifest.py).
//  - A script cannot read its own .gs source, so each .gs file carries a stamp,
//    `var BP_VER_<FileName> = 'YYYY-MM-DD HH:MM';`, kept equal to its header by
//    the same script. A .gs file is "missing" when its stamp is undefined.
//  - A sidebar .html file is read with HtmlService and its header comment
//    ("Last updated on ...") is the stamp. A file that cannot be opened is
//    "missing".
//  - Files in this document that master does not list ("not on master") are
//    found by probing the usual names (Code, Code1 ... Code40; Sidebar,
//    Sidebar1 ... Sidebar40). Greg's wording: the user is probably working with
//    test scripts that have not been officially released.
//
// KNOWN LIMITS (also in HANDOFF.md 3.5):
//  - A script cannot list its own files, so a not-on-master file is only found
//    if it follows the Code<N>.gs / Sidebar<N>.html naming, and a .gs file only
//    if it carries a stamp.
//  - A forgotten stamp bump makes a file look current when it is not.
//  - appsscript.json (permissions) cannot be read from inside the script, so a
//    release that adds a permission cannot be flagged here.
//
// GAS FLAT NAMESPACE. Names end in 14 / 14_. Reuses saveLines13_ (Code13.gs).
// SCOPES. UrlFetchApp: script.external_request (already present).
// ============================================================

var BP_VER_Code14 = '2026-11-03 12:15';  // keep equal to "Last updated on" above; Code14.gs reads it

var MANIFEST_URL_14 = 'https://raw.githubusercontent.com/extrasnow75-bit/blueprint-tools-script/master/version-manifest.json';
var MAX_PROBE_14 = 40;
var STAMP_HTML_RE_14 = /Last updated on (\d{4}-\d{2}-\d{2}) at (\d{2}:\d{2})/;


function showVersionDialog14() {
  var html = HtmlService.createHtmlOutputFromFile('Sidebar14').setWidth(460).setHeight(440);
  // Modeless (Greg agreed 2026-11-03): the document stays usable while the dialog is open, so the list can be worked through while pasting files. The blocking form is
  // showModalDialog.
  DocumentApp.getUi().showModelessDialog(html, 'Blueprint Tools Version Check');
}

/**
 * Runs the comparison.
 * @returns {{ok: boolean, error?: string, total: number, current: number,
 *   outdated: Array, missing: Array, newer: Array, extra: Array, checkedAt: string}}
 */
function runVersionCheck14() {
  var res = { ok: false, total: 0, current: 0, outdated: [], missing: [], newer: [], extra: [],
              checkedAt: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'MMM d, h:mm a') };
  var manifest;
  try { manifest = fetchManifest14_(); }
  catch (e) { res.error = String(e && e.message || e); return res; }

  var names = Object.keys(manifest);
  res.total = names.length;
  names.forEach(function (name) {
    var master = manifest[name], mine = localStamp14_(name);
    if (!mine) res.missing.push({ file: name, master: master });
    else if (mine < master) res.outdated.push({ file: name, yours: mine, master: master });
    else if (mine > master) res.newer.push({ file: name, yours: mine, master: master });
    else res.current++;
  });
  sortByFile14_(res.outdated); sortByFile14_(res.missing); sortByFile14_(res.newer);

  // Files here that master does not list.
  var seen = {}; names.forEach(function (n) { seen[n] = true; });
  var probe = [''];
  for (var i = 1; i <= MAX_PROBE_14; i++) probe.push(String(i));
  probe.forEach(function (n) {
    ['Code' + n + '.gs', 'Sidebar' + n + '.html'].forEach(function (name) {
      if (seen[name]) return;
      var mine = localStamp14_(name);
      if (mine) res.extra.push({ file: name, yours: mine });
    });
  });
  sortByFile14_(res.extra);
  res.ok = true;
  return res;
}

/** Optional output (Greg asked for it): a new blueprint tab or a new Google Doc. */
function saveVersionReport14(res, dest) {
  var lines = [{ text: 'Blueprint Tools Version Check', h: 1 }, { text: 'Checked ' + res.checkedAt + ' against the GitHub master branch.', h: 0 }];
  function list(title, rows, fmt) {
    if (!rows.length) return;
    lines.push({ text: title, h: 2 });
    rows.forEach(function (r) { lines.push({ text: '• ' + fmt(r), h: 0 }); });
  }
  if (!res.outdated.length && !res.missing.length && !res.newer.length && !res.extra.length) lines.push({ text: 'All ' + res.total + ' files are current with master.', h: 0 });
  list('Out of date (paste these again)', res.outdated, function (r) { return r.file + ': yours ' + r.yours + ', master ' + r.master; });
  list('On master but missing from this document (paste these)', res.missing, function (r) { return r.file + ' (master ' + r.master + ')'; });
  list('Newer than master', res.newer, function (r) { return r.file + ': yours ' + r.yours + ', master ' + r.master; });
  list('Not on master', res.extra, function (r) { return r.file + ': ' + r.yours; });
  if (res.newer.length || res.extra.length) lines.push({ text: 'You are likely working with test scripts that have not been officially released yet.', h: 0 });
  return saveLines13_(lines, 'Version Check ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'), dest);
}


// ── HELPERS ──────────────────────────────────────────────────

function fetchManifest14_() {
  var resp;
  try { resp = UrlFetchApp.fetch(MANIFEST_URL_14, { muteHttpExceptions: true, followRedirects: true }); }
  catch (e) { throw new Error('Could not reach GitHub to check. Check your connection and try again.'); }
  var code = resp.getResponseCode();
  if (code === 404) throw new Error('GitHub master does not have a version list yet (version-manifest.json), so there is nothing to compare with.');
  if (code !== 200) throw new Error('GitHub answered with an error (' + code + '). Try again in a few minutes.');
  var data;
  try { data = JSON.parse(resp.getContentText()); } catch (e) { throw new Error('The version list on GitHub could not be read.'); }
  if (!data || !data.files || typeof data.files !== 'object') throw new Error('The version list on GitHub is not in the expected format.');
  return data.files;
}

/**
 * The version stamp of one file in THIS document, or null when the file is not
 * here (or has no stamp). .gs: reads the BP_VER_<name> variable. .html: reads
 * the header comment.
 */
function localStamp14_(fileName) {
  var m = /^([A-Za-z0-9]+)\.(gs|html)$/.exec(fileName);
  if (!m) return null;
  if (m[2] === 'gs') {
    try {
      // Runs in the shared global scope, so it sees var and const from every file.
      var v = new Function('return typeof BP_VER_' + m[1] + " !== 'undefined' ? BP_VER_" + m[1] + ' : null;')();
      return typeof v === 'string' && v ? v : null;
    } catch (e) { return null; }
  }
  try {
    var txt = HtmlService.createHtmlOutputFromFile(m[1]).getContent();
    var h = STAMP_HTML_RE_14.exec(txt);
    return h ? h[1] + ' ' + h[2] : null;
  } catch (e) { return null; }
}

function sortByFile14_(rows) {
  rows.sort(function (a, b) {
    var na = parseInt((a.file.match(/\d+/) || [0])[0], 10), nb = parseInt((b.file.match(/\d+/) || [0])[0], 10);
    return a.file.replace(/\d+/, '').localeCompare(b.file.replace(/\d+/, '')) || na - nb;
  });
}
